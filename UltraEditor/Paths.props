<Project>
	<Import Project="Paths.local.props" Condition="Exists('Paths.local.props')" />
	<PropertyGroup>
		<!-- Override in ignored Paths.local.props or with -p:ULTRAKILLPath=... -->
		<ULTRAKILLPath Condition="'$(ULTRAKILLPath)' == ''">$(MSBuildThisFileDirectory)..\Game</ULTRAKILLPath>

		<!-- Derived paths for the local game installation. -->
		<ManagedPath>$(ULTRAKILLPath)\ULTRAKILL_Data\Managed</ManagedPath>
		<BepInExPath>$(ULTRAKILLPath)\BepInEx</BepInExPath>
		<CorePath>$(BepInExPath)\core</CorePath>
		<PluginPath>$(BepInExPath)\plugins</PluginPath>
		
		<!-- Copy only when explicitly requested with -p:DeployToGame=true. -->
		<CopyPath Condition="'$(CopyPath)' == ''">$(PluginPath)\UltraEditor</CopyPath>
		<DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
	</PropertyGroup>
</Project>
